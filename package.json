{
  "name": "maroonrides",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && pnpm sqlite:wasm || echo ''",
    "sqlite:wasm": "cp node_modules/sql.js/dist/sql-wasm.wasm static/assets/sql-wasm.wasm",
    "api:generate": "openapi-typescript ../api/openapi.json -o src/lib/api/openapi.d.ts",
    "db:generate": "drizzle-kit generate",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "pmtiles": "./pmtiles/cstat.sh",
    "test": "vitest run"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.2",
    "@types/semver": "^7.8.0",
    "@types/sql.js": "^1.4.11",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sql.js": "1.11.0",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "8.3.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/preferences": "^8.0.1",
    "@googlemaps/polyline-codec": "^1.0.28",
    "@leveluptuts/svelte-fit": "^1.0.3",
    "@tanstack/svelte-query": "^6.0.18",
    "aggie-spirit-api": "^1.3.4",
    "drizzle-orm": "^0.45.3",
    "jeep-sqlite": "^2.8.0",
    "lodash-es": "^4.18.1",
    "luxon": "^3.7.2",
    "maplibre-gl": "^5.17.0",
    "mode-watcher": "^1.1.0",
    "moment": "^2.30.1",
    "openapi-fetch": "^0.17.0",
    "pmtiles": "^4.4.0",
    "semver": "^7.8.5",
    "zod": "^4.3.6"
  }
}
